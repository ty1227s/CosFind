    { "name": "商品を検索", "short_name": "商品検索", "url": "/products?source=pwa-shortcut", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "在庫を報告", "short_name": "在庫報告", "url": "/report?source=pwa-shortcut", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
